{
  "_meta": {
    "title": "Single Frame Style Test — no AnimateDiff",
    "description": "Verify style match before adding temporal complexity. Runs one frame through IP-Adapter + ControlNet."
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "toonyou_beta6.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "fluffy orange and cream longhair cat walking, side view, illustration style, soft warm tones, detailed fur texture, children's book illustration, white background, consistent character design, warm amber and cream colors",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "realistic, photographic, 3d render, deformed, extra limbs, mutation, bad anatomy, inconsistent style, dark background, multiple cats, blurry, low quality, watermark, background shapes, geometric background, rectangles, squares, abstract background, busy background, gradient background",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "cat_walk_rendered.jpeg" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "cat_pose_sheet.webp" }
  },
  "6": {
    "class_type": "CLIPVisionLoader",
    "inputs": { "clip_name": "clip_vision_g.safetensors" }
  },
  "7": {
    "class_type": "IPAdapterModelLoader",
    "inputs": { "ipadapter_file": "ip-adapter-plus_sd15.safetensors" }
  },
  "8": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": ["7", 0],
      "image": ["4", 0],
      "clip_vision": ["6", 0],
      "weight": 0.8,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "9": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["8", 0],
      "ipadapter": ["7", 0],
      "image": ["5", 0],
      "clip_vision": ["6", 0],
      "weight": 0.3,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "frames/frame_0001.png" }
  },
  "11": {
    "class_type": "LineArtPreprocessor",
    "inputs": {
      "image": ["10", 0],
      "resolution": 512,
      "coarse": "disable"
    }
  },
  "12": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "control_v11p_sd15_lineart.pth" }
  },
  "13": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["12", 0],
      "image": ["11", 0],
      "strength": 0.45,
      "start_percent": 0.0,
      "end_percent": 0.75
    }
  },
  "15": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 }
  },
  "17": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["9", 0],
      "positive": ["13", 0],
      "negative": ["13", 1],
      "latent_image": ["15", 0],
      "seed": 42,
      "steps": 22,
      "cfg": 7.5,
      "sampler_name": "euler_ancestral",
      "scheduler": "karras",
      "denoise": 0.7
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["17", 0],
      "vae": ["1", 2]
    }
  },
  "19": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["18", 0],
      "filename_prefix": "cat_single_frame"
    }
  }
}
